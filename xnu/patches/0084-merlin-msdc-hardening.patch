+/*
+ * MERLIN addition: console dump of the recorded history of a single
+ * element, called from zalloc_uaf_panic() so that zone corruption
+ * debugging ("-zc zlog<n>=<zone>") works without a kernel debugger.
+ * Operation numbers are the caller's namespace (zalloc: 1=ZOP_ALLOC,
+ * 0=ZOP_FREE).
+ */
+void
+btlog_dump_element_history(
+	btlog_t                 btlog,
+	vm_address_t            element)
+{
+	btlogu_t                btlu = { .btl = btlog };
+	mach_vm_address_t       bt[BTLOG_MAX_DEPTH];
+	uint32_t                j;
+
+	if (btlog == NULL) {
+		return;
+	}
+
+	__btlog_lock(btlu);
+	if (btlu.btl->btl_disabled) {
+		__btlog_unlock(btlu);
+		printf("zone-log: disabled\n");
+		return;
+	}
+
+	switch (btlu.btl->btl_type) {
+	case BTLOG_LOG:
+		for (uint32_t i = 0; i < btlu.btl->btl_count; i++) {
+			struct bt_log_entry *btle = &btlu.btll->btll_entries[i];
+			if (btle->btle_addr == 0) {
+				break;
+			}
+			if (btle->btle_addr != element) {
+				continue;
+			}
+			for (j = 0; j < BTLOG_MAX_DEPTH; j++) {
+				bt[j] = 0;
+			}
+			btref_decode_unslide(__bt_ref(btle->btle_where), bt);
+			printf("zone-log #%u: elem %p op %u bt:", i,
+			    (void *)btle->btle_addr,
+			    (unsigned)__bt_op(btle->btle_where));
+			for (j = 0; j < BTLOG_MAX_DEPTH && bt[j] != 0; j++) {
+				printf(" %p", (void *)(uintptr_t)bt[j]);
+			}
+			printf("\n");
+		}
+		break;
+	default:
+		printf("zone-log: element dumps need a BTLOG_LOG log "
+		    "(type %d)\n", (int)btlu.btl->btl_type);
+		break;
+	}
+	__btlog_unlock(btlu);
+}
