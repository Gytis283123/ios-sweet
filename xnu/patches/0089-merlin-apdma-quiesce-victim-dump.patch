+/* MERLIN (0089): boot #14 exonerated the MSDC engine (dma spill=0 on
+ * both panic rounds, readverify clean), and the scribbler fills the
+ * victims with all-0xff, like an idle-high UART wire feed.  The MTK
+ * APDMA block (/ap_dma@11000000 in the stock DTB, #address-cells=2 so
+ * reg = {0, 0x11000000, 0, 0x1000}) holds the UART VFF DMA channels:
+ * the DT lists four 0x80-byte windows at 0x980/0xa00/0xa80/0xb00
+ * ("mediatek,mt6577-uart-dma").  If LK left a console RX channel armed
+ * at hand-off, its VFF engine keeps streaming the idle-high RX line
+ * (0xff bytes) into a stale ring buffer forever.  Scan every channel
+ * window, report any with live state (EN/INT_EN/ADDR/LEN/WPT/RPT), and
+ * stop the armed DT-declared ones with the stock terminate sequence
+ * (VFF_FLUSH=1 poll self-clear, VFF_STOP=1 poll VFF_EN==0, STOP=0,
+ * INT_EN=0, INT_FLAG=0x3, warm reset, zero ADDR/LEN/THRE). */
+#define MSDC_VFF_INT_FLAG	0x00
+#define MSDC_VFF_INT_EN		0x04
+#define MSDC_VFF_EN		0x08
+#define MSDC_VFF_RST		0x0c
+#define MSDC_VFF_STOP		0x10
+#define MSDC_VFF_FLUSH		0x14
+#define MSDC_VFF_ADDR		0x1c
+#define MSDC_VFF_LEN		0x24
+#define MSDC_VFF_THRE		0x28
+#define MSDC_VFF_WPT		0x2c
+#define MSDC_VFF_RPT		0x30
+#define MSDC_APDMA_WIN		0x80
+
+static void
+merlin_apdma_quiesce(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	vm_offset_t base;
+	uint32_t w, armed = 0, quiesced = 0;
+	uint64_t dl;
+
+	if (SecureDTLookupEntry(NULL, "/ap_dma@11000000", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 4 * sizeof(uintptr_t)) {
+		printf("MERLIN MSDC: apdma: no /ap_dma@11000000 reg (skip)\n");
+		return;
+	}
+	/* the stock node is two address + two size cells:
+	 * {0, 0x11000000, 0, 0x1000} */
+	base = ml_io_map(reg[1], reg[3]);
+	if (!base) {
+		printf("MERLIN MSDC: apdma: cannot map 0x%08x\n",
+		    (uint32_t)reg[1]);
+		return;
+	}
+	for (w = 0; w < 0x1000; w += MSDC_APDMA_WIN) {
+		uint32_t en = *(volatile uint32_t *)(base + w + MSDC_VFF_EN);
+		uint32_t inten = *(volatile uint32_t *)(base + w + MSDC_VFF_INT_EN);
+		uint32_t addr = *(volatile uint32_t *)(base + w + MSDC_VFF_ADDR);
+		uint32_t len = *(volatile uint32_t *)(base + w + MSDC_VFF_LEN);
+		uint32_t wpt = *(volatile uint32_t *)(base + w + MSDC_VFF_WPT);
+		uint32_t rpt = *(volatile uint32_t *)(base + w + MSDC_VFF_RPT);
+
+		if (!en && !inten && !addr && !len && !wpt && !rpt) {
+			continue;
+		}
+		armed++;
+		printf("MERLIN MSDC: apdma win 0x%03x en 0x%x int_en 0x%x "
+		    "addr 0x%08x len 0x%x wpt 0x%x rpt 0x%x\n",
+		    w, en, inten, addr, len, wpt, rpt);
+		if (en == 0) {
+			continue;
+		}
+		if (w != 0x980 && w != 0xa00 && w != 0xa80 && w != 0xb00) {
+			printf("MERLIN MSDC: apdma armed window outside the DT "
+			    "channel windows (left alone)\n");
+			continue;
+		}
+		/* stock terminate sequence (linux mtk-uart-apdma.c) */
+		*(volatile uint32_t *)(base + w + MSDC_VFF_FLUSH) = 1;
+		dl = deadline_in(10ull * 1000 * 1000);
+		while (*(volatile uint32_t *)(base + w + MSDC_VFF_FLUSH) == 1) {
+			if (mach_absolute_time() > dl) {
+				printf("MERLIN MSDC: apdma flush did not clear\n");
+				break;
+			}
+		}
+		*(volatile uint32_t *)(base + w + MSDC_VFF_STOP) = 1;
+		dl = deadline_in(MSDC_DMA_STOP_NS);
+		while (*(volatile uint32_t *)(base + w + MSDC_VFF_EN) != 0) {
+			if (mach_absolute_time() > dl) {
+				printf("MERLIN MSDC: apdma channel would not stop\n");
+				break;
+			}
+		}
+		*(volatile uint32_t *)(base + w + MSDC_VFF_STOP) = 0;
+		*(volatile uint32_t *)(base + w + MSDC_VFF_INT_EN) = 0;
+		*(volatile uint32_t *)(base + w + MSDC_VFF_INT_FLAG) = 0x3u;
+		*(volatile uint32_t *)(base + w + MSDC_VFF_RST) = 1;
+		*(volatile uint32_t *)(base + w + MSDC_VFF_ADDR) = 0;
+		*(volatile uint32_t *)(base + w + MSDC_VFF_LEN) = 0;
+		*(volatile uint32_t *)(base + w + MSDC_VFF_THRE) = 0;
+		quiesced++;
+	}
+	printf("MERLIN MSDC: apdma %u window(s) with live state, %u armed "
+	    "window(s) quiesced\n", armed, quiesced);
 }
 
