+			} else {
+				merlin_withheld++;
+			}
 		}
 	}
 	vm_page_pages = vm_pages_count; /* used to report to user space */
@@ -1587,8 +1593,10 @@
 	if (!vm_himemory_mode) {
 		do {
 			if (!VMP_ERROR_GET(&vm_pages[--i])) {               /* skip retired pages */
-				if (merlin_excluded_ppnum_p(VM_PAGE_GET_PHYS_PAGE(&vm_pages[i])))
+				if (merlin_excluded_ppnum_p(VM_PAGE_GET_PHYS_PAGE(&vm_pages[i]))) {
+					merlin_withheld++;
 					continue;
+				}
 				vm_page_release_startup(&vm_pages[i]);
 			}
 		} while (i != 0);
@@ -1598,6 +1606,8 @@
 	/* MERLIN (0094): re-enable the exclusion window now that the page array
 	 * is built with contiguous pages. */
 	merlin_excl_enabled = TRUE;
+	printf("MERLIN: withheld %u exclusion-window pages from the free pool\n",
+	    merlin_withheld);
 
 	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
 	printf("pmap_startup() init/release time: %lld microsec\n", (now_ns - start_ns) / NSEC_PER_USEC);
