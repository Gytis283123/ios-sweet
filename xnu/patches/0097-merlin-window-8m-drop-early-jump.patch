- * 0x9fa08000 (boot 21), carrying verbatim SCP firmware bytes or an
- * all-0xff fill.  The writer is blind to XNU, so the robust fix is to
- * never hand its window to the VM.  Boot-arg merlin_excl_pa=START-LEN
- * (hex, e.g. 0x9f800000-0x280000) overrides the default window. */
+ * modified after free at pa 0x9f98a000 / 0x9f9ea000 (boot 20),
+ * 0x9fa08000 (boot 21) and 0x9fae0000 (boot 27, val
+ * 0xeedffd7f3eefaae9), carrying a sparse patched-firmware pattern or an
+ * all-0xff fill.  Every victim photographed so far is inside
+ * 0x9f800000-0xa0000000, so the default window is 8 MB: 0092's
+ * 0x280000 length stopped at 0x9fa80000 and let 0x9fae0000 through,
+ * re-arming the same panic on the 0094 image.  The writer is blind to
+ * XNU, so the robust fix is to never hand its window to the VM.
+ * Boot-arg merlin_excl_pa=START-LEN (hex, e.g. 0x9f800000-0x800000)
+ * overrides the default window. */
 static uint64_t merlin_excl_start = 0x9f800000ull;
-static uint64_t merlin_excl_len = 0x280000ull;
+static uint64_t merlin_excl_len = 0x800000ull;
 
