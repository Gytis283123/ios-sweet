xnu: MERLIN 0097 exclusion window spans the SCP+modem MPU regions + drop the 0095 early-jump

Boot 28 (0094 + merlin_excl_pa=0x9f800000-0x800000) still panicked in
data.kalloc.16384, but the culprit is not a live scribbler: the LK EMI MPU
log in expdb.bin shows that the AP's managed range contains two protected
spans - 0x9f900000-0x9fefffff (SCP) and 0xae000000-0xbdffffff (modem,
powered off but still mapped).  Freed kalloc elements in either span read
back nonzero, so the zalloc zero-on-free check reports "element modified
after free".  Boot 28's first victim bytes (06 d2 04 6c 00 6d 17 4e ...)
occur verbatim in md1img.bin at offset 0x76cc0, proving the modem span; the
boot 20/21/27 victims at 0x9f98a000 / 0x9f9ea000 / 0x9fa08000 / 0x9fae0000
are the SCP span.

1. merlin_excl_start/len default 0x9f800000/0x280000 -> 0x9f900000/
   0x1e700000, i.e. 0x9f900000-0xbe000000.  This withholds 487 MiB
   (31,168 16 KiB pages) and leaves about 708 MiB usable (745 MiB managed
   minus the kernel image below topOfKernelData).
2. Drop 0095's early jump.  pmap_next_page() jumped first_avail to the end
   of the window on its first call; first_avail is topOfKernelData
   (~0x824e4000), far below the window, so the jump discarded ~476 MB of
   usable RAM (0x824e4000-0xa0000000).  A packed vm_page array is indexed
   by physical page, so a hole can only be skipped by sacrificing
   everything below it - 0094's suspend-during-enumeration + withhold-at-
   release is the only affordable scheme.
3. Two unconditional one-line prints so a boot photo shows the active
   window and how many pages the release loop actually withheld
   (0092's skip print never fires, 0095's jump print is gone).

--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2632,15 +2632,23 @@
 	return pmap_next_page(pnum);
 }
 
-/* MERLIN (0092): boots 11-21 photographed a physical-address-anchored
- * scribbler (an SCP-side dump writer): freed zone elements were
- * modified after free at pa 0x9f98a000 / 0x9f9ea000 (boot 20) and
- * 0x9fa08000 (boot 21), carrying verbatim SCP firmware bytes or an
- * all-0xff fill.  The writer is blind to XNU, so the robust fix is to
- * never hand its window to the VM.  Boot-arg merlin_excl_pa=START-LEN
- * (hex, e.g. 0x9f800000-0x280000) overrides the default window. */
-static uint64_t merlin_excl_start = 0x9f800000ull;
-static uint64_t merlin_excl_len = 0x280000ull;
+/* MERLIN (0092/0097): XNU is given 0x80000000-0xcd000000, but the LK EMI
+ * MPU keeps two spans inside it reserved for other masters:
+ *   0x9f900000-0x9fefffff  SCP firmware/DRAM
+ *   0xae000000-0xbdffffff  modem (md_mem_usage; powered off, still mapped)
+ * A freed kalloc element in either span reads back nonzero because the AP
+ * cannot rewrite it: the zalloc zero-check then reports a bogus "modified
+ * after free".  Boot-28's first victim bytes (06 d2 04 6c ...) are verbatim
+ * md1img.bin at offset 0x76cc0, proving the modem span; boot 27's
+ * 0x9fae0000 victim and the earlier 0x9f98a000 / 0x9f9ea000 / 0x9fa08000
+ * ones are the SCP span.  Keep both spans out of the VM: the default window
+ * 0x9f900000-0xbe000000 (0x1e700000 bytes, 487 MiB) leaves
+ * 0x80000000-0x9f900000 and 0xbe000000-0xcd000000, about 708 MiB
+ * usable once the kernel image below topOfKernelData is subtracted.
+ * Boot-arg merlin_excl_pa=START-LEN (hex, e.g. 0x9f900000-0x1e700000)
+ * overrides the default window. */
+static uint64_t merlin_excl_start = 0x9f900000ull;
+static uint64_t merlin_excl_len = 0x1e700000ull;
 
 /* MERLIN (0094): when FALSE, pmap_next_page() skips the exclusion check so
  * pmap_startup() can iterate physical pages contiguously for the vm_page_array.
@@ -2686,18 +2694,24 @@
 		return;
 	}
 	done = true;
-	if (!PE_parse_boot_argn("merlin_excl_pa", buf, sizeof(buf))) {
-		return;
-	}
-	merlin_excl_start = merlin_hex(buf, &p);
-	if (*p != '-') {
-		return;
-	}
-	merlin_excl_len = merlin_hex(p + 1, &p);
+	if (PE_parse_boot_argn("merlin_excl_pa", buf, sizeof(buf))) {
+		merlin_excl_start = merlin_hex(buf, &p);
+		if (*p == '-') {
+			merlin_excl_len = merlin_hex(p + 1, &p);
+		}
+	}
 	if (merlin_excl_len == 0) {
-		merlin_excl_start = 0x9f800000ull;
-		merlin_excl_len = 0x280000ull;
-	}
+		merlin_excl_start = 0x9f900000ull;
+		merlin_excl_len = 0x1e700000ull;
+	}
+	/* MERLIN (0097): one unconditional line so a boot photo proves which
+	 * window this kernel runs with.  0092's skip print only fires if the
+	 * enumeration walks into the window, which it never does: the
+	 * vm_page array is built with the exclusion suspended. */
+	printf("MERLIN: exclusion window PA 0x%llx-0x%llx "
+	    "(%llu pages kept out of the VM)\n",
+	    merlin_excl_start, merlin_excl_start + merlin_excl_len,
+	    merlin_excl_len >> PAGE_SHIFT);
 }
 
 
@@ -2710,27 +2724,17 @@
 	}
 
 	merlin_excl_init();
-	/* MERLIN (0095): jump first_avail past the scribbler window on the
-	 * first call, before the vm_page array depends on slot/ppnum
-	 * alignment: the packed array then enumerates one contiguous run
-	 * above the window, the mid-loop skip (and with it the
-	 * vm_resident.c:2627 assert) can never fire, and the scribbler
-	 * band is never part of the VM.  Pages below the window are
-	 * sacrificed (~30 MB). */
-	if ((uint64_t)first_avail < merlin_excl_start + merlin_excl_len) {
-		uint64_t skip = merlin_excl_start + merlin_excl_len -
-		    (uint64_t)first_avail;
-		uint64_t pages = skip >> PAGE_SHIFT;
-
-		printf("MERLIN: pmap early-jump past scribbler window to "
-		    "0x%llx (%llu pages never enumerated)\n",
-		    merlin_excl_start + merlin_excl_len, pages);
-		first_avail = merlin_excl_start + merlin_excl_len;
-		if (pages > (uint64_t)avail_page_count) {
-			pages = avail_page_count;
-		}
-		avail_page_count -= (unsigned int)pages;
-	}
+	/* MERLIN (0097): 0095's early jump set first_avail to the END of the
+	 * window on the first call.  first_avail is topOfKernelData
+	 * (~0x824e4000 here), i.e. far BELOW the window, so that jump threw
+	 * away ~476 MB of usable RAM (0x824e4000-0xa0000000) instead of just
+	 * the window: the packed vm_page array is indexed by physical page,
+	 * so a hole cannot be skipped without sacrificing everything below
+	 * it.  0097 therefore keeps 0094's scheme - enumerate contiguously
+	 * with merlin_excl_enabled cleared, withhold the window at release
+	 * time - and only the mid-loop skip below remains, unreachable
+	 * because enumeration never enters the window while the flag is
+	 * clear. */
 	if (merlin_excl_enabled && first_avail != avail_end &&
 	    (uint64_t)first_avail >= merlin_excl_start &&
 	    (uint64_t)first_avail < merlin_excl_start + merlin_excl_len) {
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -1541,6 +1541,9 @@
 extern boolean_t merlin_excl_enabled;
 extern boolean_t merlin_excluded_ppnum_p(ppnum_t);
 merlin_excl_enabled = FALSE;
+/* MERLIN (0097): count what the window actually withheld so a boot photo
+ * proves the window is live and how much RAM it costs. */
+unsigned int merlin_withheld = 0;
 
 	for (i = 0; i < npages; i++) {
 		/* Did we run out of pages? */
@@ -1578,8 +1581,11 @@
 			fillPage(phys_page, fillval);
 		}
 		if (vm_himemory_mode) {
-			if (!merlin_excluded_ppnum_p(phys_page))
