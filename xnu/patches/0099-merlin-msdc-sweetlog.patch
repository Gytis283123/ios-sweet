xnu: MERLIN 0099 write the console ring to userdata through MSDC

The 0047 console ring (sweet_log_ring, fed by every _cnputs character)
is drained only by the UFS driver, so on merlin the whole kernel and
daemon log stays in RAM and a boot loop leaves no trace behind.

Add the MSDC twin of sweet_log_thread(), started at the end of
merlin_msdc_init() once the userdata partition is known:

  - the same SWEETLOG header (version 1, 4 MiB ring) in the last
    4 MiB + 4 KiB of the partition, so tools/sweet-log.py and
    tools/sweet-log-pull.sh read it unchanged;
  - the ring is written in 4 KiB blocks = 8 sectors, coalesced up to
    msdc_blocks/8 blocks per CMD25 (64 KiB bounce limit), under
    merlin_msdc_lock;
  - the first flush happens right after attach (so even a short boot
    leaves a log), then every ufslogsecs (default 10 s); disabled with
    sweetlog=0.  The thread prints where it writes and how often.

The partition is 48.489 GiB with the HFS+ volume at its start, so the
tail is free; nothing is written before mo.ready.

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1506,6 +1506,107 @@ msdc_write_blocks(uint64_t lba, uint32_t nblk)
 	return msdc_transfer(lba, nblk, true);
 }
 
+/*
+ * 0099: console log over MSDC.
+ *
+ * The 0047 ring (sweet_log_ring, fed by every _cnputs character) is drained
+ * by sweet_log_thread() above only when the UFS root driver initialises, so
+ * a merlin boot (MSDC root) keeps the whole log in RAM and nothing is ever
+ * written.  This is the MSDC twin: the same "SWEETLOG" header and 4 MiB ring
+ * in the last 4 MiB + 4 KiB of the userdata partition, written in 4 KiB
+ * blocks (8 sectors each) through the 0098 multi-block path.  The on-disk
+ * layout is byte-identical to the UFS one, so tools/sweet-log.py and
+ * tools/sweet-log-pull.sh work unchanged.
+ */
+#define MSDC_LOG_SECS_PER_BLOCK (UFS_BLOCK / MSDC_SECTOR)
+#define MSDC_LOG_SECTORS \
+	((uint64_t)SWEET_LOG_BLOCKS * MSDC_LOG_SECS_PER_BLOCK)
+
+static void
+merlin_msdc_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = mo.first_block + mo.nblocks - MSDC_LOG_SECTORS;
+	uint64_t flushed = 0, seq = 0;
+	/* 4 KiB blocks per command, capped by msdc_blocks (and the bounce) */
+	uint32_t per = msdc_max_blocks / MSDC_LOG_SECS_PER_BLOCK;
+
+	if (per == 0) {
+		per = 1;
+	}
+	printf("MERLIN LOG: console log to the last %llu KiB of userdata "
+	    "(sector 0x%llx), every %u s\n",
+	    MSDC_LOG_SECTORS / 2, base, sweet_log_secs);
+	for (;;) {
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+
+		if (total != flushed) {
+			uint64_t pos = total - flushed >= SWEET_LOG_SIZE ?
+			    total - SWEET_LOG_SIZE : flushed;
+			int error = 0;
+
+			lck_mtx_lock(&merlin_msdc_lock);
+			while (pos < total && !error) {
+				uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+				uint32_t blk = off / UFS_BLOCK;
+				uint64_t need = ((uint64_t)off % UFS_BLOCK +
+				    (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+				uint32_t n = (uint32_t)MIN(MIN(need,
+				    (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+				    (uint64_t)per);
+
+				memcpy((void *)mo.dma,
+				    sweet_log_ring + (uint64_t)blk * UFS_BLOCK,
+				    (size_t)n * UFS_BLOCK);
+				error = msdc_write_blocks(base +
+				    (uint64_t)(1 + blk) * MSDC_LOG_SECS_PER_BLOCK,
+				    n * MSDC_LOG_SECS_PER_BLOCK);
+				pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+			}
+			if (!error) {
+				struct sweet_log_header h = {
+					.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+					.version = 1, .size = SWEET_LOG_SIZE,
+					.total = total, .seq = ++seq,
+				};
+
+				bzero((void *)mo.dma, UFS_BLOCK);
+				memcpy((void *)mo.dma, &h, sizeof(h));
+				error = msdc_write_blocks(base,
+				    MSDC_LOG_SECS_PER_BLOCK);
+			}
+			lck_mtx_unlock(&merlin_msdc_lock);
+			if (error) {
+				printf("MERLIN LOG: write failed (%d), stopping\n",
+				    error);
+				return;
+			}
+			flushed = total;
+		}
+		(void)tsleep(&sweet_log_chan, PZERO, "msdclog",
+		    hz * (int)sweet_log_secs);
+	}
+}
+
+static void
+merlin_msdc_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !mo.ready || mo.nblocks < 2 * MSDC_LOG_SECTORS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(merlin_msdc_log_thread, NULL, &thread) ==
+	    KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* Read nsec 512-byte sectors at absolute lba into dst. */
 static int
 msdc_read(uint64_t lba, uint32_t nsec, void *dst)
@@ -1949,6 +2050,8 @@ merlin_msdc_init(void)
 	printf("MERLIN MSDC: \"%s\" first sector 0x%llx, %llu MiB, read-only\n",
 	    want, (unsigned long long)mo.first_block,
 	    (unsigned long long)(mo.nblocks * MSDC_SECTOR >> 20));
+	/* 0099: keep the 0047 console ring on disk for post-mortem boots */
+	merlin_msdc_log_start();
 	return 0;
 }
 
