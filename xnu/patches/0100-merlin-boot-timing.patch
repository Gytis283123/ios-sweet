+/* 0100: time every data command (failures included) and print a throughput
+ * line per 16 MiB.  A 1 s timeout per CMD18 would read as ~64 KiB/s; healthy
+ * multi-block reads should be tens of MiB/s. */
+static int
+msdc_transfer(uint64_t lba, uint32_t nblk, bool is_write)
+{
+	uint64_t t0 = mach_absolute_time();
+	int error = msdc_transfer_once(lba, nblk, is_write);
+	uint64_t dt = mach_absolute_time() - t0;
+
+	msdc_stat_cmds++;
+	msdc_stat_sectors += nblk;
+	msdc_stat_ticks += dt;
+	if (msdc_stat_on && msdc_stat_cmds <= 5) {
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(dt, &ns);
+		printf("MERLIN MSDC: cmd %llu %s x%u took %llu us\n",
+		    (unsigned long long)msdc_stat_cmds,
+		    is_write ? "write" : "read", nblk,
+		    (unsigned long long)(ns / 1000));
+	}
+	if (msdc_stat_on && msdc_stat_sectors >= msdc_stat_next) {
+		uint64_t total_ns = 0, last_ns = 0;
+
+		absolutetime_to_nanoseconds(msdc_stat_ticks, &total_ns);
+		absolutetime_to_nanoseconds(dt, &last_ns);
+		printf("MERLIN MSDC: %llu cmds %llu KiB in %llu ms -> %llu KiB/s"
+		    " (last CMD%u x%u %llu us)\n",
+		    (unsigned long long)msdc_stat_cmds,
+		    (unsigned long long)(msdc_stat_sectors / 2),
+		    (unsigned long long)(total_ns / 1000000),
+		    (unsigned long long)(total_ns ?
+		    (msdc_stat_sectors / 2) * 1000000000ull / total_ns : 0),
+		    is_write ? 25u : 18u, nblk,
+		    (unsigned long long)(last_ns / 1000));
+		msdc_stat_next += 16ull * 1024 * 1024 / MSDC_SECTOR;
+	}
+	return error;
+}
+
