xnu: MERLIN 0100 boot-speed instrumentation (CPU clock, MSDC throughput, log clock)

The 0098 multi-block boot still takes tens of minutes to reach the
userspace loop, far beyond the ~7 min of the old one-sector kernel.
Before changing the driver again, measure:

  - the arch counter value at attach in ms (mach_absolute_time, 13 MHz):
    if the SoC counter starts at zero this is the time from power-on to
    the MSDC driver, which says whether the slow part is LK/shim/kernel
    init before the driver or the card path after it;
  - a CPU probe at attach (boot-arg msdcprobe=0 disables it): 4 M
    dependent adds timed by the 13 MHz arch counter, printed as ~MHz
    core assuming 2 cycles/iteration.  A core left at 100 MHz by the
    bootloader would explain a slow kernel and a slow userspace boot;
    a ~2 GHz reading means the CPU is not the problem;
  - msdc_transfer() now times every data command (failures included):
    the first five print their own latency and every 16 MiB a line
    gives commands, KiB, elapsed ms, KiB/s and the last command size.
    A per-command timeout stall reads as ~64 KiB/s, a healthy CMD18
    path as tens of MiB/s;
  - the 0099 log thread prints "MERLIN LOG: flush N at S.mmm s" before
    each flush, so the on-disk log carries a 10 s timeline of the boot
    (the marker is part of the flush it dates);
  - merlin_msdc_init() prints its own elapsed time.

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1220,6 +1220,61 @@ msdc_take_over(void)
 	return 0;
 }
 
+/* 0100: boot-speed instrumentation.
+ *
+ * The 0098 boot still takes tens of minutes, so measure instead of guessing:
+ *  - the arch counter at attach in ms: if the SoC counter starts at zero this
+ *    is the time from power-on to the MSDC driver, which separates a slow
+ *    pre-driver boot (LK/shim/kernel init) from a slow card path;
+ *  - one CPU probe at attach: a dependent-add loop timed by the 13 MHz arch
+ *    counter gives the core clock to ~10% (assuming 2 cycles/iteration);
+ *  - command/sector/time counters in msdc_transfer(), printed every 16 MiB,
+ *    so a per-command stall (timeout) shows up as a low KiB/s at once;
+ *  - the first few commands print their own latency;
+ *  - every log flush carries the ms since the log thread started.
+ * msdcprobe=0 skips the CPU probe.
+ */
+static uint64_t msdc_stat_cmds, msdc_stat_sectors, msdc_stat_ticks;
+static uint64_t msdc_stat_next = 16ull * 1024 * 1024 / MSDC_SECTOR;
+static bool msdc_stat_on = true;
+
+static uint64_t
+merlin_cpu_probe(uint32_t iters)
+{
+	uint64_t n = iters;
+	uint64_t t0 = mach_absolute_time();
+
+	__asm__ volatile(
+	    "1:\n\t"
+	    "subs %0, %0, #1\n\t"
+	    "b.ne 1b\n\t"
+	    : "+r"(n) : : "cc");
+
+	return mach_absolute_time() - t0;
+}
+
+static void
+merlin_cpu_report(void)
+{
+	uint32_t on = 1;
+	uint64_t ns = 0;
+	uint64_t frq;
+	uint64_t now = mach_absolute_time();
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frq));
+	absolutetime_to_nanoseconds(now, &ns);
+	printf("MERLIN CLK: cntfrq %llu Hz, hz %d, counter now %llu ms\n",
+	    (unsigned long long)frq, hz, (unsigned long long)(ns / 1000000));
+	PE_parse_boot_argn("msdcprobe", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	absolutetime_to_nanoseconds(merlin_cpu_probe(4u << 20), &ns);
+	printf("MERLIN CLK: %u dependent adds in %llu us -> ~%llu MHz core "
+	    "(2 cycles/iter)\n", 4u << 20, (unsigned long long)(ns / 1000),
+	    (unsigned long long)(ns ? (2ull * (4u << 20) * 1000) / ns : 0));
+}
