+/*
+ * 0102: the 0101 log shows backboardd presenting full-screen 1125x2436
+ * ARGB layers while the phone shows only the boot logo, so dump a coarse
+ * luminance thumbnail of the panel once early and once after 200 presents.
+ * A black, a static or a changing frame is then visible in the log itself.
+ */
+static void
+sweet_fb_thumb(const char *tag, const uint8_t *p, uint32_t rowBytes,
+    int32_t w, int32_t h)
+{
+	static const char ramp[] = " .:-=+*#%@";
+	uint32_t nz = 0;
+	uint64_t sig = 1469598103934665603ULL;
+
+	if (p == NULL || w <= 0 || h <= 0 || rowBytes == 0) {
+		return;
+	}
+	IOLog("SWEET FB: %s %dx%d row %u\n", tag, w, h, rowBytes);
+	for (int32_t gy = 0; gy < 40; gy++) {
+		char line[33];
+		for (int32_t gx = 0; gx < 32; gx++) {
+			int32_t x = (int32_t)((int64_t)gx * (w - 1) / 31);
+			int32_t y = (int32_t)((int64_t)gy * (h - 1) / 39);
+			uint32_t v = 0;
+			uint32_t lum;
+			memcpy(&v, p + (uint64_t)y * rowBytes + (uint64_t)x * 4, 4);
+			sig = (sig ^ v) * 1099511628211ULL;
+			if ((v & 0x00ffffff) != 0) {
+				nz++;
+			}
+			lum = (((v >> 16) & 0xff) + ((v >> 8) & 0xff) + (v & 0xff)) / 3;
+			line[gx] = ramp[(lum * 9) / 255];
+		}
+		line[32] = 0;
+		IOLog("SWEET FB: |%s|\n", line);
+	}
+	IOLog("SWEET FB: %s nonzero %u/1280 sig %016llx\n", tag, nz,
+	    (unsigned long long)sig);
+}
 
