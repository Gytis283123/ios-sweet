+/* Enable PMCCNTR_EL0 on this CPU and count every core clock (PMCR.D = 0). */
+static void
+sweet_pmu_start_counter(void)
+{
+	uint64_t pmcr = __builtin_arm_rsr64("PMCR_EL0");
+
+	pmcr &= ~PMCR_D;
+	pmcr |= PMCR_E | PMCR_C;
+	__builtin_arm_wsr64("PMCR_EL0", pmcr);
+	__builtin_arm_wsr64("PMCNTENSET_EL0", PMCNTENSET_CNTEN0);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* Core cycles (PMCCNTR) vs the 13 MHz arch counter (CNTPCT) over ~10 ms. */
+static int
+sweet_measure_cpu_mhz(void)
+{
+	uint64_t cntfrq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t c0, c1, t0, t1;
+
+	if (cntfrq == 0) {
+		return -1;
+	}
+	c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	t0 = __builtin_arm_rsr64("CNTPCT_EL0");
+	uint64_t target = t0 + cntfrq / 100;
+	do {
+		t1 = __builtin_arm_rsr64("CNTPCT_EL0");
+	} while (t1 < target);
+	c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+
+	if (c1 == c0 || t1 == t0) {
+		return -1;	/* PMCCNTR not counting (trapped or absent) */
+	}
+	return (int)(((c1 - c0) * cntfrq) / ((t1 - t0) * 1000000ULL));
+}
