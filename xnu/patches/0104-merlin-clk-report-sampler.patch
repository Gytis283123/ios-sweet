+/*
+ * Re-print the boot clocks after the persistent console log is attached:
+ * initCPU()'s own lines run before the log ring sees kprintf output.
+ */
+extern "C" void
+sweet_report_cpu_clocks(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+
+	for (unsigned int i = 0; i < topology->num_cpus && i < MAX_CPUS; i++) {
+		int mhz = __atomic_load_n(&sweet_cpu_mhz[i], __ATOMIC_ACQUIRE);
+		if (mhz > 0) {
+			kprintf("SWEET CLK: cpu=%u mpidr=0x%llx %u MHz\n", i,
+			    (unsigned long long)__atomic_load_n(&sweet_cpu_mpidr[i],
+			    __ATOMIC_ACQUIRE), (unsigned)mhz);
+		} else {
+			kprintf("SWEET CLK: cpu=%u PMU trapped, clock unknown\n", i);
+		}
+	}
+}
