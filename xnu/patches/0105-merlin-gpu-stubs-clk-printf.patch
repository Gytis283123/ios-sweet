diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685..e2e69c6 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -79,4 +79,48 @@ SweetPlatformExpert::processTopLevel(IORegistryEntry *root)
  * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
  * is what the iPhone userland (MobileGestalt) expects.
  */
+
+/*
+ * Stub GPU accelerators. backboardd keeps matching IOAcceleratorES /
+ * IOAcceleratorESLegacy / AGXAccelerator while SpringBoard's main thread
+ * sits in a BoardServices XPC call (LATEST-86). Merlin has no GPU driver,
+ * so publish inert services with those class names: matching and
+ * notifications succeed, IOServiceOpen returns kIOReturnUnsupported, and
+ * the compositor keeps using the software framebuffer path.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	const char *name = getMetaClass()->getClassName();
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setName(name);
+	registerService();
+	IOLog("SWEET GPU: %s published (stub; no renderer)\n", name);
+	return true;
+}
+
+class IOAcceleratorESLegacy : public IOAcceleratorES {
+	OSDeclareDefaultStructors(IOAcceleratorESLegacy);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorESLegacy, IOAcceleratorES);
+
+class AGXAccelerator : public IOAcceleratorES {
+	OSDeclareDefaultStructors(AGXAccelerator);
+};
+
+OSDefineMetaClassAndStructors(AGXAccelerator, IOAcceleratorES);
+
 #endif /* SWEET */
